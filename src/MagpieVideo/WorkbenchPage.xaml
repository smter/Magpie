<Page x:Class="MagpieVideo.WorkbenchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

	<!-- 单页工作台：页序固定 —— 选择视频 → DLSSNR 参数 → 单帧对比 → 输出设置（折叠）→ 底部粘性操作条 -->
	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- 标题/品牌 + DLSSNR 徽章 -->
		<Grid Grid.Row="0"
		      Padding="24,16"
		      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
		      BorderThickness="0,0,0,1"
		      ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
			        Width="40"
			        Height="40"
			        Background="{StaticResource MagpieVideoAccentBrush}"
			        CornerRadius="8"
			        VerticalAlignment="Center">
				<TextBlock Text="MV"
				           FontSize="16"
				           FontWeight="Bold"
				           Foreground="#06121A"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center" />
			</Border>

			<StackPanel Grid.Column="1"
			            VerticalAlignment="Center">
				<TextBlock Text="MagpieVideo"
				           FontSize="20"
				           FontWeight="SemiBold" />
				<TextBlock Text="离线视频 DLSSNR 处理"
				           FontSize="12"
				           Foreground="{StaticResource MagpieVideoSubtleTextBrush}" />
			</StackPanel>

			<Border Grid.Column="3"
			        Style="{StaticResource MagpieVideoBadgeStyle}"
			        VerticalAlignment="Center">
				<TextBlock Style="{StaticResource MagpieVideoBadgeTextStyle}"
				           Text="DLSSNR · 同分辨率 AI 降噪" />
			</Border>
		</Grid>

		<!-- 可滚动内容区 -->
		<ScrollViewer Grid.Row="1"
		              VerticalScrollBarVisibility="Auto">
			<StackPanel MaxWidth="880"
			            Padding="24,20"
			            HorizontalAlignment="Stretch">
				<!-- 1. 选择视频 -->
				<Border Style="{StaticResource MagpieVideoCardStyle}">
					<StackPanel>
						<Grid Padding="16,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border Width="22"
							        Height="22"
							        Background="{StaticResource MagpieVideoAccentBrush}"
							        CornerRadius="11"
							        Margin="0,0,8,0">
								<TextBlock Text="1"
								           FontSize="12"
								           FontWeight="Bold"
								           Foreground="#06121A"
								           HorizontalAlignment="Center"
								           VerticalAlignment="Center" />
							</Border>
							<TextBlock Grid.Column="1"
							           FontSize="15"
							           FontWeight="SemiBold"
							           Text="选择视频" />
							<TextBlock Grid.Column="2"
							           FontSize="12"
							           Foreground="{StaticResource MagpieVideoSubtleTextBrush}"
							           Text="单个文件 · 一次一个" />
						</Grid>
						<Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						        BorderThickness="0,1,0,0" />
						<Border Style="{StaticResource MagpieVideoPlaceholderStyle}"
						        Margin="16">
							<StackPanel HorizontalAlignment="Center"
							            Spacing="8">
								<FontIcon Glyph="&#xE8B7;"
								          FontSize="30"
								          Foreground="{StaticResource MagpieVideoSubtleTextBrush}"
								          HorizontalAlignment="Center" />
								<TextBlock Text="将视频文件拖放到这里，或点击选择"
								           Foreground="{StaticResource MagpieVideoMutedTextBrush}"
								           HorizontalAlignment="Center" />
								<Button Content="选择视频文件…"
								        Style="{StaticResource AccentButtonStyle}"
								        IsEnabled="False"
								        HorizontalAlignment="Center" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>

				<!-- 2. DLSSNR 处理参数 -->
				<Border Style="{StaticResource MagpieVideoCardStyle}">
					<StackPanel>
						<Grid Padding="16,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border Width="22"
							        Height="22"
							        Background="{StaticResource MagpieVideoAccentBrush}"
							        CornerRadius="11"
							        Margin="0,0,8,0">
								<TextBlock Text="2"
								           FontSize="12"
								           FontWeight="Bold"
								           Foreground="#06121A"
								           HorizontalAlignment="Center"
								           VerticalAlignment="Center" />
							</Border>
							<TextBlock Grid.Column="1"
							           FontSize="15"
							           FontWeight="SemiBold"
							           Text="DLSSNR 处理参数" />
							<TextBlock Grid.Column="2"
							           FontSize="12"
							           Foreground="{StaticResource MagpieVideoSubtleTextBrush}"
							           Text="T3 接入参数面板" />
						</Grid>
						<Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						        BorderThickness="0,1,0,0" />
						<Border Style="{StaticResource MagpieVideoPlaceholderStyle}"
						        Margin="16">
							<TextBlock Text="参数面板占位（NR 预设 / 强度 / 帧引导模式 / 深度推断间隔 …）"
							           Foreground="{StaticResource MagpieVideoMutedTextBrush}"
							           HorizontalAlignment="Center" />
						</Border>
					</StackPanel>
				</Border>

				<!-- 单帧对比 -->
				<Border Style="{StaticResource MagpieVideoCardStyle}">
					<StackPanel>
						<Grid Padding="16,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border Width="22"
							        Height="22"
							        Background="{StaticResource MagpieVideoAccentBrush}"
							        CornerRadius="11"
							        Margin="0,0,8,0">
								<TextBlock Text="≋"
								           FontSize="12"
								           FontWeight="Bold"
								           Foreground="#06121A"
								           HorizontalAlignment="Center"
								           VerticalAlignment="Center" />
							</Border>
							<TextBlock Grid.Column="1"
							           FontSize="15"
							           FontWeight="SemiBold"
							           Text="单帧对比" />
							<TextBlock Grid.Column="2"
							           FontSize="12"
							           Foreground="{StaticResource MagpieVideoSubtleTextBrush}"
							           Text="T6 接入" />
						</Grid>
						<Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						        BorderThickness="0,1,0,0" />
						<Border Style="{StaticResource MagpieVideoPlaceholderStyle}"
						        Margin="16">
							<TextBlock Text="对比器占位（原片 / 处理后 分隔对比）"
							           Foreground="{StaticResource MagpieVideoMutedTextBrush}"
							           HorizontalAlignment="Center" />
						</Border>
					</StackPanel>
				</Border>

				<!-- 3. 输出设置（默认折叠） -->
				<Border Style="{StaticResource MagpieVideoCardStyle}">
					<muxc:Expander HorizontalAlignment="Stretch"
					               HorizontalContentAlignment="Stretch"
					               IsExpanded="False">
						<muxc:Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock FontSize="15"
								           FontWeight="SemiBold"
								           Text="输出设置" />
								<TextBlock FontSize="12"
								           Foreground="{StaticResource MagpieVideoSubtleTextBrush}"
								           Text="默认折叠" />
							</StackPanel>
						</muxc:Expander.Header>
						<Border Style="{StaticResource MagpieVideoPlaceholderStyle}"
						        Margin="16,0,16,16">
							<TextBlock Text="输出设置占位（编码器 H.264/HEVC · CQP · 输出路径 · 音频直通）"
							           Foreground="{StaticResource MagpieVideoMutedTextBrush}"
							           HorizontalAlignment="Center" />
						</Border>
					</muxc:Expander>
				</Border>

				<!-- 页脚 -->
				<TextBlock FontSize="11"
				           Foreground="{StaticResource MagpieVideoSubtleTextBrush}"
				           Text="MagpieVideo · GPLv3 · DLSSNR 运行时为第三方组件（NGX），按发布包披露 · 配置：%LOCALAPPDATA%\MagpieVideo\config\v1"
				           TextWrapping="Wrap"
				           HorizontalAlignment="Center" />
			</StackPanel>
		</ScrollViewer>

		<!-- 底部粘性操作条 -->
		<Border Grid.Row="2"
		        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
		        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
		        BorderThickness="0,1,0,0"
		        Padding="24,14">
			<Grid ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
				        Content="▶ 开始处理"
				        Style="{StaticResource AccentButtonStyle}"
				        IsEnabled="False" />

				<StackPanel Grid.Column="1"
				            VerticalAlignment="Center"
				            Spacing="4">
					<TextBlock FontSize="12"
					           Foreground="{StaticResource MagpieVideoSubtleTextBrush}"
					           Text="选择视频后开始处理" />
					<ProgressBar Height="4"
					             IsIndeterminate="False"
					             Maximum="100"
					             Visibility="Collapsed" />
				</StackPanel>

				<Button Grid.Column="2"
				        Content="取消"
				        IsEnabled="False" />
			</Grid>
		</Border>
	</Grid>
</Page>
