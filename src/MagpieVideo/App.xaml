<Application x:Class="MagpieVideo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
             RequestedTheme="Dark">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<muxc:XamlControlsResources ControlsResourcesVersion="Version2" />
			</ResourceDictionary.MergedDictionaries>

			<!-- 工作台主题色（与原型一致） -->
			<Color x:Key="MagpieVideoAccentColor">#4CC2FF</Color>
			<SolidColorBrush x:Key="MagpieVideoAccentBrush"
			                 Color="{StaticResource MagpieVideoAccentColor}" />
			<SolidColorBrush x:Key="MagpieVideoCardBorderBrush"
			                 Color="#3A3A3A" />
			<SolidColorBrush x:Key="MagpieVideoMutedTextBrush"
			                 Color="#A8A8A8" />
			<SolidColorBrush x:Key="MagpieVideoSubtleTextBrush"
			                 Color="#6D6D6D" />

			<!-- DLSSNR 徽章 -->
			<Style x:Key="MagpieVideoBadgeStyle"
			       TargetType="Border">
				<Setter Property="Background" Value="#1F4A66" />
				<Setter Property="CornerRadius" Value="4" />
				<Setter Property="Padding" Value="8,3" />
			</Style>
			<Style x:Key="MagpieVideoBadgeTextStyle"
			       TargetType="TextBlock">
				<Setter Property="Foreground" Value="{StaticResource MagpieVideoAccentBrush}" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="FontWeight" Value="SemiBold" />
			</Style>

			<!-- 卡片（节） -->
			<Style x:Key="MagpieVideoCardStyle"
			       TargetType="Border">
				<Setter Property="Background" Value="#202020" />
				<Setter Property="BorderBrush" Value="{StaticResource MagpieVideoCardBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="8" />
				<Setter Property="Margin" Value="0,0,0,16" />
			</Style>

			<!-- 占位区 -->
			<Style x:Key="MagpieVideoPlaceholderStyle"
			       TargetType="Border">
				<Setter Property="Background" Value="#252525" />
				<Setter Property="BorderBrush" Value="{StaticResource MagpieVideoCardBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="8" />
				<Setter Property="Padding" Value="16" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
